# The store is rebuilt by `uv run python ingest.py` from public sources. It is
# ~40 MB and changes on every refresh of ClinVar, so it is regenerated, never
# committed.
locus.duckdb
locus.duckdb.*
phase0_scratch.duckdb

# Cached upstream downloads (AlphaFold entries, AlphaMissense CSVs, raw PDBs).
# Regenerated on demand by ingest.py.
#
# The leading slash is load-bearing: a bare `data/` matches a directory of that
# name at ANY depth, which silently swallowed site/data/ — the payloads the
# deployed site is built from.
/data/

# Generated site payloads. NOT committed: the Pages workflow rebuilds them on
# every deploy and on a weekly schedule, and uploads the result as an artifact
# rather than pushing it. Committing them would add well over 100 MB a year to
# the history for no benefit, and would let the deployed site drift from the
# pipeline the tests cover.
#
# Build them locally with: uv run python ingest.py && uv run python export_site.py
site/data/
site/vendor/

# Exported decision logs may contain analyst names and rationales.
locus-decisions-*.json

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
node_modules/
.DS_Store
Thumbs.db
